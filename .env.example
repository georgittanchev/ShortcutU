# Copy to .env and fill in. server.js reads it at startup.

# Required. A random string of at least 32 characters, e.g. `openssl rand -hex 32`
JWT_SECRET=

# MySQL
DB_HOST=localhost
DB_USER=shortcutu
DB_PASSWORD=
DB_NAME=shortcutu

PORT=3222
# Interface for plain HTTP mode (behind a reverse proxy)
HOST=127.0.0.1

# Optional: serve HTTPS directly instead of behind a proxy
# TLS_KEY=/path/to/privkey.pem
# TLS_CERT=/path/to/fullchain.pem
# TLS_CA=/path/to/chain.pem

# Optional: restrict which origins may call the API (default *)
# CORS_ORIGIN=chrome-extension://<your-extension-id>
