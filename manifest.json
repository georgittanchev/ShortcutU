{
    "manifest_version": 3,
    "name": "ShortcutU",
    "version": "1.1",
    "description": "Type a short trigger, get your saved text. Text expander with sync; what you type stays in your browser.",
    "homepage_url": "https://tanchev.net/shortcutu/",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png"
        },
        "default_title": "ShortcutU"
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://shortcuts.tanchev.net/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "options_page": "options.html"
}
